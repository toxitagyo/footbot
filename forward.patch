 def form_factor(tb, team):
     x = tb.get(team)
     if not x or x["p"] < 5:
         return 1.0
     pts = lambda f: sum(3 if c == "W" else 1 if c == "D" else 0 for c in f)
     d = pts(x["form"][-5:]) / 5 - x["pts"] / x["p"]
     return 1 + 0.04 * max(-1, min(1, d))
 
